# ============================================================
# Trading Bot v2 — Configuration (.env)
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# === TELEGRAM ===
# Token fourni par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID pour les notifications automatiques.
# Laisser vide et utiliser /register dans le bot pour le remplir automatiquement.
# Ou récupérer via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# === ANTHROPIC / CLAUDE API ===
# Requis pour Phase 2+ (analyse IA avancée). Non requis en Phase 1.
ANTHROPIC_API_KEY=sk-ant-...

# === COINBASE ===
# Mode paper : aucune clé requise (simulation locale, prix réels via API publique)
# Mode live  : clés API Coinbase Advanced Trade requises
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_MODE=paper   # paper | live  ← NE JAMAIS passer en live sans validation complète

# === PROJET ===
LOG_LEVEL=INFO
DB_PATH=memory/trading.db

# === TRADING ===
TRADING_SYMBOL=BTC-USDC       # Paire tradée
LOOP_INTERVAL_S=60            # Intervalle entre chaque tick (secondes)
PRICE_HISTORY_SIZE=60         # Taille de l'historique prix (min 51 pour EMA50 trend filter)

# === DASHBOARD WEB (local) ===
DASHBOARD_PORT=8080           # Port du dashboard http://localhost:8080
DASHBOARD_ENABLED=true        # Activer le dashboard web local

# === RISK — paramètres de gestion du risque ===
RISK_MAX_POSITION_PCT=0.02    # Taille max d'un trade (2% du portefeuille)
RISK_MIN_CONFIDENCE=0.55      # Confiance minimale du signal pour trader (55%)
RISK_MIN_USDC_TRADE=10.0      # Montant USDC minimum par trade
RISK_STOP_LOSS_PCT=0.03       # Stop-loss automatique (-3% depuis l'entree)
RISK_TAKE_PROFIT_PCT=0.05     # Take-profit automatique (+5% depuis l'entree)
RISK_TRAILING_STOP_PCT=0.02   # Trailing stop : vente si chute de 2% depuis le peak
RISK_TRAILING_ACTIVATE=0.02   # Active le trailing une fois +2% au-dessus de l'entree
RISK_CONFIDENCE_BASE=0.70     # Confiance de reference pour le scaling (1.0x position)
RISK_MAX_SCALE=1.50           # Plafond du scaling (x1.5 max si haute confiance)

# === COMPORTEMENT BOT ===
SIGNAL_CONFIRM_TICKS=2        # Nb de ticks consecutifs avant d'agir sur un signal
TRADE_COOLDOWN_S=300          # Cooldown apres un trade (secondes)

# === STRATEGIE ===
STRATEGY_VOL_MIN_PCT=0.05     # Volatilite min pour trader (% std/prix sur 20 ticks)
                              # 0.05 = permissif (defaut), 0.10 = conservateur

# === STRATEGY ENSEMBLE (Tier 3) ===
USE_ENSEMBLE_STRATEGY=true    # Active le vote pondere entre 3 strategies
ENSEMBLE_MIN_SCORE=1.2        # Score minimum (weight*confidence) pour trader

MULTI_VOL_FILTER=0.7          # Multi-indicator : bloque si volume < 0.7 * moyenne
MR_RSI_BUY=32                 # Mean reversion : RSI seuil BUY (oversold)
MR_RSI_SELL=68                # Mean reversion : RSI seuil SELL (overbought)

# === SL/TP DYNAMIQUE (ATR-based) ===
ATR_BASED_SLTP=true           # Active SL/TP adaptes a la volatilite (ATR)
ATR_SL_MULT=1.5               # SL = 1.5 * ATR
ATR_TP_MULT=2.5               # TP = 2.5 * ATR (R/R 1:1.67)
ATR_SL_MIN_PCT=0.015          # Plancher SL : 1.5%
ATR_SL_MAX_PCT=0.05           # Plafond SL : 5%

# === CORRELATION CAP (limite exposition inter-bots) ===
RISK_MAX_COMBINED_EXPOSURE_PCT=0.06   # Max 6% du portefeuille en positions cumulees

# === ORDER BOOK SPREAD CHECK ===
LIVE_MAX_SPREAD_PCT=0.15      # Refuse ordre si spread > 0.15% (marche illiquide)

# === PROTECTION POSITIONS / BOT ===
POSITION_MAX_AGE_H=24         # Auto-close si position ouverte > X heures (zombie)
FLASH_MOVE_THRESHOLD=0.05     # Pause si prix bouge > 5% en 1 tick (flash crash/pump)
FLASH_PAUSE_S=180             # Duree de pause apres flash move (secondes)
BOT_MAX_DAILY_LOSS_PCT=0.05   # Auto-pause bot si perte 24h > 5%

# === TRADE JOURNAL & BACKUP ===
JOURNAL_INTERVAL_S=3600       # Re-export CSV toutes les X secondes (defaut 1h)
DB_BACKUP_INTERVAL_H=6        # Backup DB toutes les X heures
DB_BACKUP_KEEP=10             # Nombre de backups a garder (rotation)

# === ADAPTIVE PARAM TUNING (Opus 4.7, dimanche 21h UTC) ===
PARAM_TUNE_DOW_UTC=6          # Jour de la semaine (6=Dimanche)
PARAM_TUNE_HOUR_UTC=21        # Heure UTC

# === NEWS SENTIMENT (Claude Haiku scoring RSS crypto) ===
NEWS_CHECK_INTERVAL_S=3600    # Fetch + score toutes les X secondes (defaut 1h)
NEWS_NOTIFY_THRESHOLD=0.3     # Notif Telegram si |Δscore| > X

# === FRAIS COINBASE ===
COINBASE_TAKER_FEE_PCT=0.0075 # Frais taker Coinbase Advanced PAR COTE (palier ~0.75%)
                              # Round-trip = 1.50%, affiche dans notifs Telegram

# === LIVE TRADING ===
LIVE_MIN_TRACK_USDC=5.0       # Positions live < X USDC ignorees (dust filter)
SWARM_STARTUP_STAGGER_S=3.0   # Delai entre demarrage de chaque bot (anti-burst 429 au boot)

# === ORDRES MAKER (limit post-only sur les entrees BUY) ===
# Maker ~moitie du taker -> divise par ~2 le cout aller-retour, double le R:R net.
# Fill NON garanti : limit post-only au bid, attente, sinon annule + fallback market.
# A VALIDER EN LIVE (poll/cancel SDK) avant activation -> defaut OFF.
LIVE_USE_MAKER_ENTRIES=false  # true pour activer les entrees maker
MAKER_FILL_TIMEOUT_S=45       # attente max d'un fill avant annulation
MAKER_POLL_S=3                # intervalle de polling du statut
MAKER_FALLBACK_MARKET=true    # si non rempli : retomber sur un ordre market (taker)

# === FILTRE D'ENTREE — GATE DE TENDANCE (regime filter) ===
# Interdit d'acheter a contre-tendance (price <= EMA50). Cause racine du
# saignement : achats de rebonds en marche baissier -> stops immediats.
ENTRY_REQUIRE_UPTREND=true    # false pour autoriser les achats sous l'EMA50
ENTRY_TREND_BUFFER_PCT=0.0    # marge mini au-dessus de l'EMA50 (ex 0.005 = +0.5%)

# === DAILY SUMMARY ===
DAILY_SUMMARY_HOUR_UTC=9      # Heure UTC du resume quotidien Telegram
DAILY_SUMMARY_MIN_UTC=0

# === WEEKLY STATS ===
WEEKLY_STATS_DOW_UTC=0        # Jour de la semaine (0=Lundi, 6=Dimanche)
WEEKLY_STATS_HOUR_UTC=9       # Heure UTC
WEEKLY_STATS_MIN_UTC=5        # Minute (5 min apres le daily)

# === MILESTONE TRACKER ===
MILESTONE_CHECK_INTERVAL_S=300  # Verifie les paliers toutes les X secondes (5 min)

# === DISCORD WEBHOOK (optionnel, en parallele de Telegram) ===
# Cree un webhook sur Discord : Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# === FEAR & GREED ADAPTIVE SIZING ===
RISK_FG_ADAPTIVE=true         # true = position size selon F&G (panique=+30%, euphorie=-40%)
