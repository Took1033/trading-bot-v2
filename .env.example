# ============================================================
# Trading Bot v2 — Configuration (.env)
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# === TELEGRAM ===
# Token fourni par @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID pour les notifications automatiques.
# Laisser vide et utiliser /register dans le bot pour le remplir automatiquement.
# Ou récupérer via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# === ANTHROPIC / CLAUDE API ===
# Requis pour Phase 2+ (analyse IA avancée). Non requis en Phase 1.
ANTHROPIC_API_KEY=sk-ant-...

# === COINBASE ===
# Mode paper : aucune clé requise (simulation locale, prix réels via API publique)
# Mode live  : clés API Coinbase Advanced Trade requises
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_MODE=paper   # paper | live  ← NE JAMAIS passer en live sans validation complète

# === PROJET ===
LOG_LEVEL=INFO
DB_PATH=memory/trading.db

# === TRADING ===
TRADING_SYMBOL=BTC-USDC       # Paire tradée
LOOP_INTERVAL_S=60            # Intervalle entre chaque tick (secondes)
PRICE_HISTORY_SIZE=30         # Taille de l'historique prix en mémoire (min 22 pour EMA)

# === RISK — paramètres de gestion du risque ===
RISK_MAX_POSITION_PCT=0.02    # Taille max d'un trade (2% du portefeuille)
RISK_MIN_CONFIDENCE=0.55      # Confiance minimale du signal pour trader (55%)
RISK_MIN_USDC_TRADE=10.0      # Montant USDC minimum par trade
RISK_STOP_LOSS_PCT=0.03       # Stop-loss automatique (-3% depuis l'entree)
RISK_TAKE_PROFIT_PCT=0.05     # Take-profit automatique (+5% depuis l'entree)
